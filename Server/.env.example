# ============================================================================
# TerraSense NER — Backend environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ============================================================================

# Application metadata
APP_NAME=TerraSense NER API
VERSION=0.1.0
ENVIRONMENT=development

# API mount prefix. Must match the frontend's VITE_API_BASE_URL path.
# Frontend (Client/.env):  VITE_API_BASE_URL=http://localhost:8000/api
API_PREFIX=/api

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (Neon PostgreSQL + PostGIS) ---
# Neon connection string. Use the psycopg2 driver and require SSL.
# Get it from the Neon dashboard -> Connection Details (choose "psql"/"parameters").
#   postgresql+psycopg2://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST.neon.tech/terrasense?sslmode=require
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Allowed frontend origins for CORS (comma-separated).
# The React/Vite dev server runs on http://localhost:5173.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Weather (OpenWeatherMap) ---
# Server-side ONLY. Never expose this key to the frontend.
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_UNITS=metric
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_DEFAULT_DISTRICT=Aizawl
