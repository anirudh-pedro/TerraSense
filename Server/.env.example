# ============================================================================
# TerraSense NER — Backend environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ============================================================================

# Application metadata
APP_NAME=TerraSense NER API
VERSION=0.1.0
ENVIRONMENT=development

# API mount prefix. Must match the frontend's VITE_API_BASE_URL path.
# Frontend (Client/.env):  VITE_API_BASE_URL=http://localhost:8000/api
API_PREFIX=/api

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed frontend origins for CORS (comma-separated).
# The React/Vite dev server runs on http://localhost:5173.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
